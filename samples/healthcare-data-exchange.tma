    "nodes": [
      {
        "id": "n_clinician",
        "dfdRoleLegacy": false,
        "title": "Clinician",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External authorized workforce clinician using a managed browser. A valid identity alone does not authorize every patient; treatment relationship and purpose are checked by the in-scope API.\n\nPrivacy/retention: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram.",
        "type": "ExternalUser",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 40,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 78
        },
        "color": "#fed7aa"
      },
      {
        "id": "n_portal",
        "dfdRoleLegacy": false,
        "title": "Clinical Web App",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Hospital App Service frontend. Delegates clinician identity and displays only the minimum chart. Clinical payloads remain transient and are excluded from logs and client storage.\n\nPrivacy/retention: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://portal\\.healthcaredataexchange\\.example(?:/|$)",
        "position": {
          "x": 360,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_fhir",
        "dfdRoleLegacy": false,
        "title": "Clinical Exchange API",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Application-owned FHIR-compatible exchange API on App Service, not an assertion of a managed Azure FHIR product. Validates treatment relationship, consent, clinician scope and order ownership. Partner orders are minimized; results require authenticated lab identity, order binding, schema validation and replay checks before storage.\n\nPrivacy/retention: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://fhir\\.healthcaredataexchange\\.example(?:/|$)",
        "position": {
          "x": 730,
          "y": 280
        },
        "size": {
          "width": 147,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_ehr",
        "dfdRoleLegacy": false,
        "title": "Clinical SQL Repository",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Application-owned relational clinical-record repository in Azure SQL. API MI executes patient-scoped read/result procedures only; no broad table export or DDL. Clinical records follow a separately approved retention schedule; query identities stay transient. Audit and backup lifecycle require independent evidence.\n\nPrivacy/retention: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram.",
        "type": "azure.databases.sql",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 1450,
          "y": 160
        },
        "size": {
          "width": 154,
          "height": 78
        },
        "color": "#bbf7d0"
      },
      {
        "id": "n_lab",
        "dfdRoleLegacy": false,
        "title": "External Laboratory",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Separate laboratory operator with a scoped client certificate. Receives only the assigned test order and pseudonymous patient reference, not a full chart. Returns results for that order only. Contractual 30-day exchange-copy deletion is illustrative, distinct from independently governed laboratory clinical records.\n\nPrivacy/retention: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram.",
        "type": "PartnerSystem",
        "serviceTreeId": "",
        "endpointRegex": "^https://lab\\.healthcaredataexchange\\.example(?:/|$)",
        "position": {
          "x": 1450,
          "y": 530
        },
        "size": {
          "width": 144,
          "height": 78
        },
        "color": "#fed7aa"
      }
    ],
    "edges": [
      {
        "id": "e_access",
        "source": "n_clinician",
        "target": "n_portal",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Request treatment record",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. The clinician requests a patient record; the current authorized clinical summary is returned on this call. Production App ID identifies the fictional Clinician client application, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Clinical Web App validates clinician login and treatment workflow access; selected patient ID is not authorization.",
        "authenticationTypes": [
          "EntraDelegatedUserAccess"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "11111111-1111-4111-8111-111111111111",
          "tenant": "Customer"
        },
        "audience": "api://clinical-web.example",
        "waypoints": [
          {
            "id": "w_access",
            "x": 280,
            "y": 140
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_query",
        "source": "n_portal",
        "target": "n_fhir",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Authorize patient access",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Preserves clinician identity through OBO; reject a caller-selected patient without relationship and consent. In the lab workflow the order is an explicit request payload. Production App ID identifies the fictional Clinical Web App workload client, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Clinical Exchange API owns patient.read/order.submit authorization, treatment relationship, purpose/consent and minimum fields.",
        "authenticationTypes": [
          "EntraOnBehalfOf"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "22222222-2222-4222-8222-222222222222",
          "tenant": "Customer"
        },
        "audience": "api://clinical-api.example",
        "waypoints": [
          {
            "id": "w_query",
            "x": 625,
            "y": 240
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_record",
        "source": "n_fhir",
        "target": "n_ehr",
        "sourceHandle": "top",
        "targetHandle": "left",
        "title": "Read authorized summary",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Read the minimum record for the validated treatment context. Workload identity alone does not establish patient authorization.",
        "requiredAccessRights": "Reference requirement: Clinical SQL Repository grants API EXECUTE on patient-scoped read procedures only; validated patient context bounds rows/fields. No unrestricted record export.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_record",
            "x": 1160,
            "y": 185
          }
        ]
      },
      {
        "id": "e_lab",
        "source": "n_fhir",
        "target": "n_lab",
        "sourceHandle": "bottom",
        "targetHandle": "left",
        "title": "Submit minimum lab order",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Send only the test order and pseudonymous patient reference, not the full clinical chart. Direct mTLS identifies the hospital; acknowledgements are response data.",
        "requiredAccessRights": "Reference requirement: External Laboratory maps the hospital certificate to order.submit for assigned orders only; disclosure is authorized by Clinical API consent and treatment policy.",
        "authenticationTypes": [
          "ClientCertificateMtls"
        ],
        "waypoints": [
          {
            "id": "w_lab",
            "x": 1000,
            "y": 510
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_result",
        "source": "n_lab",
        "target": "n_fhir",
        "sourceHandle": "bottom",
        "targetHandle": "bottom",
        "title": "Verify bound lab result",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. A separate laboratory-initiated callback. The API rejects results for unknown/other-lab orders and only then persists the result via the following flow. The next SQL lookup retrieves the durable assigned laboratory/patient/order; acceptance requires equality with the authenticated lab and callback. A request field alone is not the source of authorization.",
        "requiredAccessRights": "Reference requirement: Clinical Exchange API maps the lab certificate to result.submit for that lab's existing order only; verify order/patient binding, schema, freshness and replay key.",
        "authenticationTypes": [
          "ClientCertificateMtls"
        ],
        "waypoints": [
          {
            "id": "w_result_out",
            "x": 1530,
            "y": 685
          },
          {
            "id": "w_result_label",
            "x": 665,
            "y": 685
          },
          {
            "id": "w_result_in",
            "x": 665,
            "y": 430
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_result_store",
        "source": "n_fhir",
        "target": "n_ehr",
        "sourceHandle": "right",
        "targetHandle": "bottom",
        "title": "Persist verified result",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. The accepted result and provenance are recorded under the patient/order relationship. No new user login is implied by the SQL acknowledgement.",
        "requiredAccessRights": "Reference requirement: Clinical SQL Repository grants API EXECUTE on append-result for the validated order only; unique event ID prevents duplicate result insertion. No overwrite of unrelated clinical records. Recheck the immutable stored patient/order/laboratory assignment and expected state atomically, preventing a race after the lookup.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_result_store",
            "x": 1180,
            "y": 305
          }
        ]
      },
      {
        "id": "e_order_store",
        "source": "n_fhir",
        "target": "n_ehr",
        "sourceHandle": "right",
        "targetHandle": "bottom",
        "title": "Record lab assignment",
        "description": "Synthetic reference design. Persist generated order ID, patient, minimum test and approved laboratory binding before any external dispatch. The order is created only after clinician consent/treatment authorization.",
        "requiredAccessRights": "Reference requirement: Clinical SQL Repository grants API EXECUTE on create-authorized-order only; bind patient/order/laboratory and reject duplicate or mismatched assignments.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_e_order_store",
            "x": 1220,
            "y": 390
          }
        ]
      },
      {
        "id": "e_order_lookup",
        "source": "n_fhir",
        "target": "n_ehr",
        "sourceHandle": "top",
        "targetHandle": "top",
        "title": "Check saved assignment",
        "description": "Synthetic reference design. On authenticated callback, look up the durable order assignment by reference; compare returned patient/laboratory/state to the verified lab certificate and callback before accepting content.",
        "requiredAccessRights": "Reference requirement: Clinical SQL Repository grants API EXECUTE on read-order-binding only; return one assigned order to the exchange API, never an unrestricted patient/order listing.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_e_order_lookup",
            "x": 1200,
            "y": 50
          }
        ]
      }
