    "comments": [
      {
        "id": "c_reference_1",
        "scenarioId": "s_secure",
        "targetKind": "node",
        "targetId": "n_fhir",
        "text": "01 | Reference - treatment access: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram. These are recommended design controls, not a claim that the synthetic system has been deployed or assessed.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      },
      {
        "id": "c_reference_2",
        "scenarioId": "s_risky",
        "targetKind": "node",
        "targetId": "n_fhir",
        "text": "02 | Reference - verified lab exchange: Clinical content is Customer Content; clinician/patient references are EUPI, not anonymous. Repository content follows a separately approved clinical schedule (over48hours does not prescribe a legal period). The partner receives no full chart and deletes exchange copies after an illustrative 30 days under contract. Clinical obligations may require other records outside this diagram. These are recommended design controls, not a claim that the synthetic system has been deployed or assessed.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      }
    ],
    "issues": [
      {
        "id": "i_sample_1",
        "origin": "authored-threat",
        "justification": "The design requires these controls; implementation and negative-test evidence remain to be reviewed. Active is not an observed exploit or risk acceptance.",
        "targetKind": "node",
        "targetId": "n_fhir",
        "scenarioIds": [
          "s_secure",
          "s_risky"
        ],
        "title": "Patient authorization bypass",
        "description": "Reference review concern: Test a valid clinician identity against an unrelated patient and changed purpose/consent; deny at API before SQL access.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      },
      {
        "id": "i_sample_2",
        "origin": "authored-threat",
        "justification": "Verify the named boundary-crossing controls before implementation approval. A declared requirement or clean deterministic result is not assurance.",
        "targetKind": "edge",
        "targetId": "e_result",
        "scenarioIds": [
          "s_risky"
        ],
        "title": "Wrong-order or replayed result",
        "description": "Reference review concern: Test other-lab certificates, mismatched patient/order, invalid schemas and duplicate/expired events. Preserve provenance before appending to the repository.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      }
    ],
