    "nodes": [
      {
        "id": "n_tenant_a",
        "dfdRoleLegacy": false,
        "title": "Tenant A User",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External user in tenant-synthetic-a. May read only A records; separate scenario data must not substitute for runtime authorization.\n\nPrivacy/retention: Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized.",
        "type": "TenantUser",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 40,
          "y": 160
        },
        "size": {
          "width": 130,
          "height": 78
        },
        "color": "#fed7aa"
      },
