      },
      {
        "id": "n_web",
        "dfdRoleLegacy": false,
        "title": "SaaS Web App",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Shared in-scope App Service frontend. Preserves delegated user context without cross-user caches. Does not select tenant authority from an untrusted URL parameter.\n\nPrivacy/retention: Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://web\\.multitenantsaasplatform\\.example(?:/|$)",
        "position": {
          "x": 360,
          "y": 300
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_gateway",
        "dfdRoleLegacy": false,
        "title": "Authorization Gateway",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. App Service authorization/orchestration API. Validates delegated subject/tenant/audience. Support export additionally requires time-bound tenant/case approval; no unscoped application-only administrative bypass.\n\nPrivacy/retention: Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://gateway\\.multitenantsaasplatform\\.example(?:/|$)",
        "position": {
          "x": 730,
          "y": 300
        },
        "size": {
          "width": 153,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_service",
        "dfdRoleLegacy": false,
        "title": "Tenant Data API",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Owns per-record access and approved support export. Independently validates delegated claims and tenant/case policy; constructs parameterized SQL tenant context and refuses missing/ambiguous scope.\n\nPrivacy/retention: Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 1500,
          "y": 300
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_db",
        "dfdRoleLegacy": false,
        "title": "Tenant SQL Database",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Shared application-owned Azure SQL database with tenant predicates/row-level policy and separate read/export procedures. Workload role may execute only these procedures; no cross-tenant bulk role, DDL or db_owner. Pool reuse must clear/rebind tenant session context.\n\nPrivacy/retention: Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized.",
        "type": "azure.databases.sql",
        "serviceTreeId": "",
