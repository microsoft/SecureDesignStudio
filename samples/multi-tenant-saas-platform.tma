    "scenarios": [
      {
        "id": "s_secure",
        "name": "01 | Reference - Tenant A read",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Business content persists only in its own tenant partition while active, with an illustrative 30-day account-closure/backup-expiry policy. Tenant IDs are OII, user references EUPI, permission claims Access Control Data, support identity Administrator Data and case material Support Data. Support response and approval/query context are processing-only; no cross-tenant batch or local download is authorized. All subject processes and stores are in scope; external participants are visible black boxes, not excluded infrastructure. Numbering orders requests; response buckets return on the same call, not a second login.",
        "nodeIds": [
          "n_tenant_a",
          "n_web",
          "n_gateway",
          "n_service",
          "n_db"
        ],
        "edgeIds": [
          "e_a",
