{
  "format": "secure-design-studio-diagram",
  "version": 2,
  "doc": {
    "version": 1,
    "authenticationDefinitions": [
      {
        "id": "EntraDelegatedUserAccess",
        "label": "Entra user",
        "description": "Calls the receiving service with an Entra access token for a signed-in user and delegated permissions.",
        "shortLabel": "Entra user",
        "behavior": {
          "productionIdentity": "required",
          "audience": true,
          "constraints": false,
          "anonymous": false,
          "managedIdentity": false
        },
        "disabled": false,
        "legacy": false,
        "aliases": [
          "Microsoft Entra ID - delegated user access"
        ]
      },
      {
        "id": "EntraOnBehalfOf",
        "label": "Entra on-behalf-of (OBO)",
        "description": "Exchanges an incoming user token for a token intended for a downstream service, preserving delegated user context.",
        "shortLabel": "OBO",
        "behavior": {
          "productionIdentity": "required",
          "audience": true,
          "constraints": false,
          "anonymous": false,
          "managedIdentity": false
        },
        "disabled": false,
        "legacy": false,
        "aliases": []
      },
      {
        "id": "EntraManagedIdentity",
        "label": "Managed identity",
        "description": "An Azure-managed system-assigned or user-assigned identity obtains an Entra access token without a manually managed application secret.",
        "shortLabel": "Managed identity",
        "behavior": {
          "productionIdentity": "required",
          "audience": true,
          "constraints": false,
          "anonymous": false,
          "managedIdentity": true
        },
        "disabled": false,
        "legacy": false,
        "aliases": []
      },
      {
        "id": "ClientCertificateMtls",
        "label": "Client certificate (mTLS)",
        "description": "The calling service presents an X.509 client certificate directly to the receiving service during mutual TLS.",
        "shortLabel": "mTLS",
        "behavior": {
          "productionIdentity": "optional",
          "audience": false,
          "constraints": false,
          "anonymous": false,
          "managedIdentity": false
        },
        "disabled": false,
        "legacy": false,
        "aliases": []
      }
    ],
    "catalogDefinitions": [
      {
        "kind": "classification",
        "id": "EUII",
        "label": "EUII",
        "description": "End User Identifiable Information. Information identifying an end user, such as an email address, User Principal Name (UPN), IP address, address book entry, user name, or display name. Aligned with [Privacy in Microsoft Purview](https://learn.microsoft.com/en-us/purview/purview-privacy#end-user-identifiable-information-euii). Other categories can also contain personal data."
      },
      {
        "kind": "classification",
        "id": "EUPI",
        "label": "EUPI",
        "description": "End User Pseudonymized Identifiers. Identifiers representing an end user, such as UserID, UserKey, or mailbox GUID, as described in [Privacy in Microsoft Purview](https://learn.microsoft.com/en-us/purview/purview-privacy#end-user-pseudonymized-identifier-eupi). They may be linked to a person using additional information. Pseudonymized does not mean anonymous."
      },
      {
        "kind": "classification",
        "id": "Access Control Data",
        "label": "Access Control Data",
        "description": "Authorization records such as permissions, roles, group memberships, or access control lists. An additional modeling category, distinct from Administrator Data about people performing administrative duties. Records can reveal security-sensitive structure and identify individuals."
      },
      {
        "kind": "classification",
        "id": "System Metadata",
        "label": "System Metadata",
        "description": "Operational metadata generated by a service, such as request IDs, timestamps, diagnostic events, or correlation identifiers. An additional modeling category, not a named Purview content type. Logs and metadata may contain EUII, EUPI, or other personal data; assess their content and linkability."
      },
      {
        "kind": "tenant",
        "id": "Customer",
        "label": "Customer"
      },
      {
        "kind": "securityBoundary",
        "id": "VNet",
        "label": "VNet",
        "description": "A modeled virtual-network perimeter. Actual isolation depends on configured connectivity and access controls."
      }
    ],
