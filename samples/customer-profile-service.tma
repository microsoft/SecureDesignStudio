    "issues": [
      {
        "id": "i_sample_1",
        "origin": "authored-threat",
        "justification": "The design requires these controls; implementation and negative-test evidence remain to be reviewed. Active is not an observed exploit or risk acceptance.",
        "targetKind": "node",
        "targetId": "n_api",
        "scenarioIds": [
          "s_secure",
          "s_risky"
        ],
        "title": "Cross-account profile update",
        "description": "Reference review concern: Test forged profile IDs and extra writable fields against the API/SQL owner predicates.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      },
      {
        "id": "i_sample_2",
        "origin": "authored-threat",
        "justification": "Verify the named boundary-crossing controls before implementation approval. A declared requirement or clean deterministic result is not assurance.",
        "targetKind": "edge",
        "targetId": "e_telemetry",
        "scenarioIds": [
          "s_risky"
        ],
        "title": "Aggregate re-identification",
        "description": "Reference review concern: Review small-count dimensions, combinations and provider onward-use terms; do not call an aggregate anonymous merely because direct identifiers were removed.",
