    "nodes": [
      {
        "id": "n_customer",
        "dfdRoleLegacy": false,
        "title": "Customer",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External customer using a browser. May view or change only their own profile. Token issuance/device management are outside this design; the customer remains a visible participant.\n\nPrivacy/retention: Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed.",
        "type": "ExternalUser",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 40,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 78
        },
        "color": "#fed7aa"
      },
      {
        "id": "n_portal",
        "dfdRoleLegacy": false,
        "title": "Profile Web App",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. EU application frontend. Validates the signed-in session and delegates only profile.write to the Profile API. Never logs contact fields or stores bearer tokens/payloads in client storage.\n\nPrivacy/retention: Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://portal\\.customerprofileservice\\.example(?:/|$)",
        "position": {
          "x": 360,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_api",
        "dfdRoleLegacy": false,
        "title": "Profile API",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Owns profile authorization: validates OBO issuer/audience/scope and derives row ownership from subject claims. Allowlists editable fields, uses parameterized SQL and emits only aggregate metrics without user/tenant identifiers.\n\nPrivacy/retention: Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://api\\.customerprofileservice\\.example(?:/|$)",
        "position": {
          "x": 730,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_db",
        "dfdRoleLegacy": false,
        "title": "Profile SQL Database",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Application-owned Azure SQL database on a logical SQL server in the EU. A contained managed-identity principal can execute profile read/update procedures only; owner predicates reject a mismatched subject. Encryption, backup expiry and account-deletion procedures are design requirements, not verified deployment controls.\n\nPrivacy/retention: Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed.",
        "type": "azure.databases.sql",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 1090,
          "y": 160
        },
        "size": {
          "width": 145,
          "height": 78
        },
        "color": "#bbf7d0"
      },
      {
        "id": "n_analytics",
        "dfdRoleLegacy": false,
        "title": "Metrics Provider",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External analytics provider receiving only windowed aggregate service counters, never contact profiles or linkable user/tenant identifiers. Contract requires purpose limitation and 30-day aggregate deletion; provider internals are a black box.\n\nPrivacy/retention: Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed.",
        "type": "ExternalSaaS",
        "serviceTreeId": "",
        "endpointRegex": "^https://analytics\\.customerprofileservice\\.example(?:/|$)",
        "position": {
          "x": 1090,
          "y": 530
        },
        "size": {
          "width": 131,
          "height": 78
        },
        "color": "#fed7aa"
      }
    ],
    "edges": [
      {
        "id": "e_login",
        "source": "n_customer",
        "target": "n_portal",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Submit own profile",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Customer submits editable contact fields; response returns the saved profile. Authentication proof is transient transport metadata; d_claims is a documentation representation, not a reusable access token. Production App ID identifies the fictional Customer client application, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Profile Web App validates delegated profile.write and subject ownership; no arbitrary account switching.",
        "authenticationTypes": [
          "EntraDelegatedUserAccess"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "11111111-1111-4111-8111-111111111111",
          "tenant": "Customer"
        },
        "audience": "api://profile-web.example",
        "waypoints": [
          {
            "id": "w_login",
            "x": 280,
            "y": 240
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_profile",
        "source": "n_portal",
        "target": "n_api",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Authorize profile update",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. The frontend exchanges the user token for this downstream API. Permissions and subject are validated independently; the response is on this same authenticated call. Production App ID identifies the fictional Profile Web App workload client, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Profile API owns profile.write and subject-to-profile binding; reject mass assignment and cross-subject row IDs.",
        "authenticationTypes": [
          "EntraOnBehalfOf"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "22222222-2222-4222-8222-222222222222",
          "tenant": "Customer"
        },
        "audience": "api://profile-api.example",
        "waypoints": [
          {
            "id": "w_profile",
            "x": 625,
            "y": 240
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_store",
        "source": "n_api",
        "target": "n_db",
        "sourceHandle": "top",
        "targetHandle": "left",
        "title": "Execute owned-row update",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. API passes an authorized subject context to parameterized stored procedures. SQL returns only the saved contact row; workload identity does not confer user delegation.",
        "requiredAccessRights": "Reference requirement: Profile SQL Database grants EXECUTE on profile read/update procedures to Profile API only; row ownership is checked from validated subject context. No db_owner, DDL or bulk export.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_store",
            "x": 940,
            "y": 185
          }
        ]
      },
      {
        "id": "e_telemetry",
        "source": "n_api",
        "target": "n_analytics",
        "sourceHandle": "bottom",
        "targetHandle": "left",
        "title": "Send aggregate counters",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Outbound disclosure is aggregated before the trust crossing. Direct mTLS authenticates the API to the separate operator, not a legal basis or proof of anonymity.",
        "requiredAccessRights": "Reference requirement: Metrics Provider maps the API client certificate to metrics.ingest for the aggregate-only schema; reject identifying fields and unapproved metric dimensions.",
        "authenticationTypes": [
          "ClientCertificateMtls"
        ],
        "waypoints": [
          {
            "id": "w_telemetry",
            "x": 940,
            "y": 465
          }
        ],
        "protocolId": "https"
      }
    ],
