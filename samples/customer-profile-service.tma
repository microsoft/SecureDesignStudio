    "scenarios": [
      {
        "id": "s_secure",
        "name": "01 | Reference - owned profile update",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Contact profiles persist while accounts are active; deletion completes within 30 days including backups. SQL retains the subject-to-profile ownership association with the profile; permission claims and subject context at other nodes are transient. External aggregates have a proposed 30-day retention and no identifying dimensions; minimization must be independently reviewed. All subject processes and stores are in scope; external participants are visible black boxes, not excluded infrastructure. Numbering orders requests; response buckets return on the same call, not a second login.",
        "nodeIds": [
          "n_customer",
          "n_portal",
          "n_api",
          "n_db"
        ],
        "edgeIds": [
          "e_login",
          "e_profile",
          "e_store"
        ],
        "edgeNumbers": {
          "e_login": 1,
          "e_profile": 2,
          "e_store": 3
        },
        "boundaryIds": [
          "b_eu",
          "b_prod"
        ],
        "nodeData": {
