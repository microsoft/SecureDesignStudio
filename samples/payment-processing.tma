    "scenarios": [
      {
        "id": "s_secure",
        "name": "01 | Reference - synchronous payment",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled. All subject processes and stores are in scope; external participants are visible black boxes, not excluded infrastructure. Numbering orders requests; response buckets return on the same call, not a second login.",
        "nodeIds": [
          "n_buyer",
          "n_checkout",
          "n_payment",
          "n_ledger",
          "n_provider"
        ],
