    "nodes": [
      {
        "id": "n_buyer",
        "dfdRoleLegacy": false,
        "title": "Buyer",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External buyer supplies an opaque, non-reusable payment token from provider-hosted collection. Card entry and token issuance are outside this model; no merchant node receives PAN or CVV.\n\nPrivacy/retention: Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled.",
        "type": "ExternalUser",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 40,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 78
        },
        "color": "#fed7aa"
      },
      {
        "id": "n_checkout",
        "dfdRoleLegacy": false,
        "title": "Checkout Web App",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Merchant frontend delegates the buyer session to the Payment API. Displays transaction or pending status. Does not trust a browser price or persist payment tokens, user tokens or form payloads.\n\nPrivacy/retention: Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://checkout\\.paymentprocessing\\.example(?:/|$)",
        "position": {
          "x": 360,
          "y": 280
        },
        "size": {
          "width": 139,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_payment",
        "dfdRoleLegacy": false,
        "title": "Payment API",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Owns buyer/order authorization. Recomputes authoritative order total, binds provider requests and idempotency keys to that order, validates provider identity, and permits ledger transitions only after verified synchronous response or callback. Callback checks amount/currency/order/event freshness and uniqueness.\n\nPrivacy/retention: Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled.",
        "type": "azure.compute.app-service-app",
        "serviceTreeId": "",
        "endpointRegex": "^https://payment\\.paymentprocessing\\.example(?:/|$)",
        "position": {
          "x": 730,
          "y": 280
        },
        "size": {
          "width": 130,
          "height": 74
        },
        "color": "#bfdbfe"
      },
      {
        "id": "n_ledger",
        "dfdRoleLegacy": false,
        "title": "Payment SQL Ledger",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Application-owned Azure SQL database on a logical SQL server. A contained Payment API managed identity executes an order-bound transaction procedure only, with unique provider event IDs and legal state transitions. No db_owner/DDL or payment token storage. Retains transaction records for an illustrative 90-day reconciliation period, subject to separately approved accounting/deletion obligations.\n\nPrivacy/retention: Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled.",
        "type": "azure.databases.sql",
        "serviceTreeId": "",
        "endpointRegex": "",
        "position": {
          "x": 1450,
          "y": 160
        },
        "size": {
          "width": 145,
          "height": 78
        },
        "color": "#bbf7d0"
      },
      {
        "id": "n_provider",
        "dfdRoleLegacy": false,
        "title": "Payment Processor",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. External processor accepts merchant-scoped direct mTLS payment requests and initiates a separately authenticated mTLS callback. Its vault/settlement interiors are a black box; independent provider retention and PCI obligations require contract review. The modeled ingress token is transient; no raw card data appears here.\n\nPrivacy/retention: Canonical order/owner, transaction outcome and deduplication evidence persist in SQL for the illustrative 90-day period; no raw PAN/CVV, password or reusable token is modeled or stored. Outside SQL, buyer/order context, claims and payment tokens are transient. The callback scenario returns pending to the buyer before the later event; a later user status query is not modeled.",
        "type": "PaymentProvider",
        "serviceTreeId": "",
        "endpointRegex": "^https://provider\\.paymentprocessing\\.example(?:/|$)",
        "position": {
          "x": 1450,
          "y": 530
        },
        "size": {
          "width": 141,
          "height": 78
        },
        "color": "#fed7aa"
      }
    ],
    "edges": [
      {
        "id": "e_checkout",
        "source": "n_buyer",
        "target": "n_checkout",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Submit tokenized order",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Buyer provides an order reference, opaque token and pseudonymous identity. The synchronous variant returns confirmed status; the callback variant returns pending, not a final outcome. Production App ID identifies the fictional Buyer client application, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Checkout Web App requires buyer payment.initiate for the signed-in subject; submission is not authority over another buyer's order.",
        "authenticationTypes": [
          "EntraDelegatedUserAccess"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "11111111-1111-4111-8111-111111111111",
          "tenant": "Customer"
        },
        "audience": "api://checkout.example",
        "waypoints": [
          {
            "id": "w_checkout",
            "x": 280,
            "y": 140
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_intent",
        "source": "n_checkout",
        "target": "n_payment",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Authorize owned order",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. OBO is targeted to Payment API, not the processor. No token/claim logging; downstream provider and SQL calls use their own workload identities. Production App ID identifies the fictional Checkout Web App workload client, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Payment API validates delegated payment.initiate and buyer-to-order ownership; recompute price and bind one idempotency key per authorized attempt.",
        "authenticationTypes": [
          "EntraOnBehalfOf"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "22222222-2222-4222-8222-222222222222",
          "tenant": "Customer"
        },
        "audience": "api://payment-api.example",
        "waypoints": [
          {
            "id": "w_intent",
            "x": 625,
            "y": 240
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_provider",
        "source": "n_payment",
        "target": "n_provider",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Authorize payment token",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Direct mTLS (not certificate-based Entra acquisition). The synchronous result is authenticated response data. For asynchronous processing it is an acceptance receipt, followed by a new callback request.",
        "requiredAccessRights": "Reference requirement: Payment Processor maps the merchant certificate to authorize-payment for the specified order/amount only; no vault export or unrestricted merchant-account administration.",
        "authenticationTypes": [
          "ClientCertificateMtls"
        ],
        "waypoints": [
          {
            "id": "w_provider",
            "x": 1180,
            "y": 435
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_ledger",
        "source": "n_payment",
        "target": "n_ledger",
        "sourceHandle": "top",
        "targetHandle": "left",
        "title": "Commit verified outcome",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Only a verified provider outcome is recorded. Transaction content and event-deduplication evidence persist for reconciliation; the payment token never crosses this flow.",
        "requiredAccessRights": "Reference requirement: Payment SQL Ledger grants Payment API EXECUTE on the order-bound transaction procedure only. Unique event IDs and transition constraints prevent replay; no token/PAN/CVV columns or broad database role. The SQL procedure atomically checks the existing order and reserved merchant attempt, exact amount/currency and previously unseen provider event before the state transition.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_ledger",
            "x": 1160,
            "y": 185
          }
        ]
      },
      {
        "id": "e_callback",
        "source": "n_provider",
        "target": "n_payment",
        "sourceHandle": "bottom",
        "targetHandle": "bottom",
        "title": "Verify payment event",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. New provider-initiated HTTPS request, not response data from Authorize payment token. mTLS proves the channel peer; payload binding and replay controls remain separate API responsibilities. Provider echoes the merchant attempt and order reference and supplies its own event ID. API verifies the channel and freshness; SQL compares these with the previously reserved order/attempt during the atomic write.",
        "requiredAccessRights": "Reference requirement: Payment API accepts only the configured processor certificate and a matching order/amount/currency; enforces event freshness, unique event ID and idempotent state transition before SQL update.",
        "authenticationTypes": [
          "ClientCertificateMtls"
        ],
        "waypoints": [
          {
            "id": "w_callback_out",
            "x": 1530,
            "y": 685
          },
          {
            "id": "w_callback_label",
            "x": 665,
            "y": 685
          },
          {
            "id": "w_callback_in",
            "x": 665,
            "y": 430
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_order_read",
        "source": "n_payment",
        "target": "n_ledger",
        "sourceHandle": "right",
        "targetHandle": "bottom",
        "title": "Reserve owned attempt",
        "description": "Synthetic reference design. Before contacting the processor, SQL validates ownership and atomically records the merchant-generated attempt binding. It returns canonical amount/currency. The input is a linkable order reference, not client financial values; no provider event exists yet.",
        "requiredAccessRights": "Reference requirement: Payment SQL Ledger grants Payment API EXECUTE on read-owned-order-and-reserve-attempt only. Bind the validated buyer subject and order reference, persist the merchant attempt idempotently against that order, and return authoritative amount/currency; reject non-owned orders and conflicting attempts.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://database.windows.net",
        "waypoints": [
          {
            "id": "w_order_read",
            "x": 1180,
            "y": 305
          }
        ]
      }
    ],
