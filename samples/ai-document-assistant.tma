    "edges": [
      {
        "id": "e_question",
        "source": "n_user",
        "target": "n_app",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Ask authorized question",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Question and documentation-only access context arrive from the worker; a cited answer returns on this request. Production App ID identifies the fictional Knowledge Worker client application, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Assistant Web App requires assistant.query for the signed-in subject and derives tenant from validated claims.",
        "authenticationTypes": [
          "EntraDelegatedUserAccess"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "11111111-1111-4111-8111-111111111111",
          "tenant": "Customer"
        },
        "audience": "api://assistant-web.example",
        "waypoints": [
          {
            "id": "w_question",
            "x": 280,
            "y": 250
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_prompt",
        "source": "n_app",
        "target": "n_gateway",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Delegate query",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. All subject frontend/gateway interiors stay in scope in both scenarios; delegated user context must survive this hop. Production App ID identifies the fictional Assistant Web App workload client, not the human. Human identity and permissions come from validated subject/delegated claims; each calling application has its own registration.",
        "requiredAccessRights": "Reference requirement: Retrieval Gateway validates assistant.query, subject and tenant; it owns document ACL decisions and rejects caller-provided authorization filters.",
        "authenticationTypes": [
          "EntraOnBehalfOf"
        ],
        "productionIdentity": {
          "kind": "AppId",
          "appId": "22222222-2222-4222-8222-222222222222",
          "tenant": "Customer"
        },
        "audience": "api://retrieval-gateway.example",
        "waypoints": [
          {
            "id": "w_prompt",
            "x": 625,
            "y": 270
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_retrieve",
        "source": "n_gateway",
        "target": "n_vector",
        "sourceHandle": "right",
        "targetHandle": "left",
        "title": "Read ACL-trimmed chunks",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. A workload token is not user delegation. Query fields and ACL evidence are transient; stored chunks/ACLs remain in the application-owned index. The response includes independently stored document ACL metadata alongside each chunk, enabling Gateway to recheck it against transient caller claims. Session scope/claims are not persisted as document ACLs.",
        "requiredAccessRights": "Reference requirement: Azure AI Search grants Gateway query-only Search Index Data Reader; Gateway constructs a validated tenant/document ACL filter and rechecks returned chunk authorization. No index write/admin rights.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://search.azure.com",
        "waypoints": [
          {
            "id": "w_retrieve",
            "x": 1040,
            "y": 392
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_generate",
        "source": "n_gateway",
        "target": "n_model",
        "sourceHandle": "top",
        "targetHandle": "left",
        "title": "Generate cited answer",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Provider receives question and minimum chunks without subject/tenant/access claims. Contract assumptions on geography and retained abuse-monitoring data must be verified independently.",
        "requiredAccessRights": "Reference requirement: Approved Azure OpenAI deployment grants Gateway inference invocation only; no deployment management or tool execution. Gateway sends only authorized grounding.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://cognitiveservices.azure.com",
        "waypoints": [
          {
            "id": "w_generate",
            "x": 940,
            "y": 190
          }
        ],
        "protocolId": "https"
      },
      {
        "id": "e_log",
        "source": "n_gateway",
        "target": "n_logs",
        "sourceHandle": "bottom",
        "targetHandle": "left",
        "title": "Ingest aggregate metrics",
        "description": "Synthetic reference design, not an observed deployment or security/compliance certification. Approved ingestion path to the modeled Log Analytics store. Reject content/identity fields before the crossing; modeled data-collection components are abstracted as part of the workspace endpoint.",
        "requiredAccessRights": "Reference requirement: Metrics ingestion endpoint authorizes Gateway for its single data collection rule; allowlist aggregate counters only. Workspace queries are separately privileged; this identity has no workspace read/admin access.",
        "authenticationTypes": [
          "EntraManagedIdentity"
        ],
        "productionIdentity": {
          "kind": "ManagedIdentity"
        },
        "audience": "https://monitor.azure.com",
