    "comments": [
      {
        "id": "c_reference_1",
        "scenarioId": "s_secure",
        "targetKind": "node",
        "targetId": "n_gateway",
        "text": "01 | Reference - authorized grounding: Questions/answers and identity context are processing-only; the index retains chunks/ACLs for active documents and purges within 24 hours of source deletion. Aggregate metrics expire after an illustrative 30 days. Provider processing-only is a contract assumption requiring review of actual provider retention, not a claim about every Azure OpenAI configuration. These are recommended design controls, not a claim that the synthetic system has been deployed or assessed.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      },
      {
        "id": "c_reference_2",
        "scenarioId": "s_risky",
        "targetKind": "node",
        "targetId": "n_gateway",
        "text": "02 | Reference - privacy-safe metrics: Questions/answers and identity context are processing-only; the index retains chunks/ACLs for active documents and purges within 24 hours of source deletion. Aggregate metrics expire after an illustrative 30 days. Provider processing-only is a contract assumption requiring review of actual provider retention, not a claim about every Azure OpenAI configuration. These are recommended design controls, not a claim that the synthetic system has been deployed or assessed.",
        "status": "Active",
        "createdAt": 1790969400000,
        "replies": []
      }
    ],
    "issues": [
